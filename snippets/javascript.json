  "PUT Route": {
    "prefix": ["njs-put", "njs-u"],
    "description": "[CRUD] Express PUT route with SQLite update",
    "body": [
      "// Requires: better-sqlite3 | Insert near routes section",
      "app.put('${1:/api/items}/:id', (req, res) => {",
      "  try {",
      "    const { ${2:name} } = req.body;",
      "    const result = db.prepare('UPDATE ${3:items} SET ${2:name} = ? WHERE id = ?').run(${2:name}, req.params.id);",
      "    if (result.changes === 0) return res.status(404).json({ error: 'Not found' });",
      "    res.json({ updated: result.changes });",
      "  } catch (err) {",
      "    res.status(500).json({ error: err.message });",
