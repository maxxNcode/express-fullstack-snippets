  "Pagination Helper": {
    "prefix": ["njs-page", "njs-pg"],
    "description": "[Utils] SQL pagination LIMIT/OFFSET helper function",
    "body": [
      "// Requires: jsonwebtoken, dotenv | Insert near routes section",
     "const paginate = (req) => {",
      "  const page = Math.max(1, parseInt(req.query.page) || 1);",
      "  const limit = Math.min(${1:100}, parseInt(req.query.limit) || ${2:20});",
      "  const offset = (page - 1) * limit;",
      "  return { page, limit, offset };",
      "};"
    ]
  },

  "Socket.io Server": {
    "prefix": ["njs-socket", "njs-sk"],
    "description": "[Realtime] Basic Socket.io setup with Express",
    "body": [
      "// Requires: socket.io, express | Insert near routes section",
      "const express = require('express');",
      "const { createServer } = require('http');",
      "const { Server } = require('socket.io');",
      "",
      "const app = express();",
      "const httpServer = createServer(app);",
      "const io = new Server(httpServer, { cors: { origin: '*' } });",
      "",
      "io.on('connection', (socket) => {",
      "  console.log('Client connected:', socket.id);",
      "",
      "  socket.on('${1:message}', (data) => {",
      "    console.log('Received:', data);",
      "    io.emit('${1:message}', data);",
      "  });",
      "",
      "  socket.on('disconnect', () => {",
      "    console.log('Client disconnected:', socket.id);",
      "  });",
      "});",
      "",
      "httpServer.listen(${2:3000}, () => {",
      "  console.log('Socket server running');",
      "});"
    ]
  },

