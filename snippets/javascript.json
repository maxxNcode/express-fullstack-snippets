  "SQLite DB Connection": {
    "prefix": ["njs-db", "njs-dbc"],
    "description": "[DB] SQLite database connection boilerplate",
    "body": [
      "// Requires: better-sqlite3 | Insert near routes section",
      "const Database = require('better-sqlite3');",
      "",
      "const db = new Database('${1:data.db}');",
      "db.pragma('journal_mode = WAL');",
      "console.log('Connected to SQLite.');",
      "",
      "// Create table",
      "db.exec(`",
      "  CREATE TABLE IF NOT EXISTS ${2:items} (",
      "    id INTEGER PRIMARY KEY AUTOINCREMENT,",
      "    ${3:title} TEXT NOT NULL,",
      "    created_at DATETIME DEFAULT CURRENT_TIMESTAMP",
      "  )",
      "`);",
      "",
      "module.exports = db;"
    ]
  },

