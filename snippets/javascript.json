    "Fetch API Wrapper": {
    "prefix": ["njs-fetch", "njs-fc"],
    "description": "[Frontend] Frontend fetch wrapper with error handling",
    "body": [
      "// Requires: jsonwebtoken, dotenv | Insert near routes section",
     "const apiFetch = async (url, options = {}) => {",
      "  try {",
      "    const res = await fetch(url, {",
      "      headers: { 'Content-Type': 'application/json', ...options.headers },",
      "      ...options",
      "    });",
      "    if (!res.ok) throw new Error(`HTTP \\${res.status}`);",
      "    return await res.json();",
      "  } catch (err) {",
      "    console.error('API Error:', err);",
      "    throw err;",
      "  }",
      "};"
    ]
  },

    "API Client Class": {
    "prefix": ["njs-api", "njs-apc"],
    "description": "[Frontend] Reusable API client class/module",
    "body": [
      "// Requires: jsonwebtoken, dotenv | Insert near routes section",
     "class ApiClient {",
      "  constructor(baseURL = '${1:http://localhost:3000}') {",
      "    this.baseURL = baseURL;",
      "  }",
      "",
      "  async request(path, options = {}) {",
      "    const res = await fetch(this.baseURL + path, {",
      "      headers: { 'Content-Type': 'application/json', ...options.headers },",
      "      ...options",
      "    });",
      "    if (!res.ok) throw new Error(`HTTP \\${res.status}: \\${res.statusText}`);",
      "    return res.status === 204 ? null : await res.json();",
      "  }",
      "",
      "  get(path) { return this.request(path); }",
      "  post(path, body) { return this.request(path, { method: 'POST', body: JSON.stringify(body) }); }",
      "  put(path, body) { return this.request(path, { method: 'PUT', body: JSON.stringify(body) }); }",
      "  del(path) { return this.request(path, { method: 'DELETE' }); }",
      "}",
      "",
      "const api = new ApiClient();",
      "module.exports = api;"
    ]
  },

