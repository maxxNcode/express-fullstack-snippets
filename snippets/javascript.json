  "Express Static Server Setup": {
    "prefix": ["njs-setup", "njs-st"],
    "description": "[Setup] Express server with static files and Better-SQLite3 database setup",
    "body": [
      "// Requires: express, better-sqlite3 | Insert near routes section",
      "const express = require('express');",
      "const path = require('path');",
      "const Database = require('better-sqlite3');",
      "",
      "const app = express();",
      "const PORT = process.env.PORT || 3000;",
      "",
      "// Connect to SQLite database (synchronous, auto WAL mode)",
      "const db = new Database('${1:data.db}');",
      "db.pragma('journal_mode = WAL');",
      "console.log('Connected to SQLite database.');",
      "",
      "// Create table if not exists",
      "db.exec(`",
      "  CREATE TABLE IF NOT EXISTS ${2:users} (",
      "    id INTEGER PRIMARY KEY AUTOINCREMENT,",
      "    ${3:name} TEXT NOT NULL",
      "  )",
      "`);",
      "console.log('Table ${2:users} is ready.');",
      "",
      "// Middleware",
      "app.use(express.json());",
      "app.use(express.urlencoded({ extended: true }));",
      "",
      "// Serve static files from the public folder",
      "app.use(express.static(path.join(__dirname, 'public')));",
      "",
      "// Root API check",
      "app.get('/', (req, res) => {",
      "  res.json({ message: 'Server is running' });",
      "});",
      "",
      "app.listen(PORT, () => {",
      "  console.log(`Server running on http://localhost:\\${PORT}`);",
      "});",
      "",
      "// Graceful shutdown",
      "process.on('SIGINT', () => {",
      "  db.close();",
      "  console.log('Database connection closed.');",
      "  process.exit(0);",
      "});"
    ]
  },

  "Fetch Item List JS": {
    "prefix": ["njs-list-js", "njs-ls"],
    "description": "[Frontend] JavaScript to fetch and render items from API (use inside <script>)",
    "body": [
      "// Requires: jsonwebtoken, dotenv | Insert near routes section",
     "const API = '${1:http://localhost:3000/api/items}';",
      "",
      "async function loadItems() {",
      "  const res = await fetch(API);",
      "  const items = await res.json();",
      "  const list = document.getElementById('${2:list}');",
      "  if (!items.length) { list.innerHTML = '<p>No items yet.</p>'; return; }",
      "  list.innerHTML = items.map(i => `",
      "    <div class=\"${3:item}\">",
      "      <div>",
      "        <b>\\${i.${4:name}}</b> <span class=\"${5:price}\">\\$\\${i.${6:price}}</span>",
      "        <p style=\"margin:4px 0 0;color:#555;\">\\${i.${7:description} || ''}</p>",
      "      </div>",
      "      <button class=\"${8:delete}\" onclick=\"remove(\\${i.id})\">Delete</button>",
      "    </div>",
      "  `).join('');",
      "}",
      "",
      "async function remove(id) {",
      "  if (!confirm('Delete this item?')) return;",
      "  await fetch(`\\${API}/\\${id}`, { method: 'DELETE' });",
      "  loadItems();",
      "}",
      "",
      "loadItems();"
    ]
  },

