  "JWT Verify Middleware": {
    "prefix": ["njs-auth", "njs-aw"],
    "description": "[Auth] Express middleware to verify JWT token with optional role check",
    "body": [
      "// Requires: jsonwebtoken, dotenv | Insert near routes section",
      "// Usage: authMiddleware() for token only, authMiddleware('admin') for role check",
      "const jwt = require('jsonwebtoken');",
      "",
      "const authMiddleware = (requiredRole = null) => {",
      "  return (req, res, next) => {",
      "    const authHeader = req.headers.authorization;",
      "    if (!authHeader?.startsWith('Bearer ')) {",
      "      return res.status(401).json({ error: 'Missing token' });",
      "    }",
      "    const token = authHeader.split(' ')[1];",
      "    try {",
      "      const decoded = jwt.verify(token, process.env.JWT_SECRET || '${1:secret}');",
      "      req.user = decoded;",
      "",
      "      if (requiredRole && decoded.role !== requiredRole) {",
      "        return res.status(403).json({ error: 'Forbidden: insufficient role' });",
      "      }",
      "",
      "      next();",
      "    } catch (err) {",
      "      return res.status(403).json({ error: 'Invalid token' });",
      "    }",
      "  };",
      "};",
      "",
      "module.exports = authMiddleware;"
    ]
  },

  "Register Route": {
    "prefix": ["njs-reg", "njs-rg"],
    "description": "[Auth] POST /auth/register - create user with bcrypt-hashed password",
    "body": [
      "// Requires: bcrypt | Insert near routes section",
      "app.post('/${1:auth/register}', async (req, res) => {",
      "  const { email, password } = req.body;",
      "  try {",
      "    const existing = db.prepare('SELECT * FROM ${2:users} WHERE email = ?').get(email);",
      "    if (existing) return res.status(400).json({ error: 'User exists' });",
      "",
      "    const bcrypt = require('bcrypt');",
      "    const hash = await bcrypt.hash(password, ${3:10});",
      "",
      "    const result = db.prepare(",
      "      `INSERT INTO ${2:users} (email, password_hash, role) VALUES (?, ?, ?)`",
      "    ).run(email, hash, '${4:user}');",
      "",
      "    res.status(201).json({ id: result.lastInsertRowid, email, role: '${4:user}' });",
      "  } catch (err) {",
      "    res.status(500).json({ error: err.message });",
      "  }",
      "});"
    ]
  },

  "Login Route": {
    "prefix": ["njs-log", "njs-lg"],
    "description": "[Auth] POST /auth/login - verify credentials and return JWT",
    "body": [
      "// Requires: bcrypt, jsonwebtoken, dotenv | Insert near routes section",
      "app.post('/${1:auth/login}', async (req, res) => {",
      "  const { email, password } = req.body;",
      "  try {",
      "    const row = db.prepare('SELECT * FROM ${2:users} WHERE email = ?').get(email);",
      "    if (!row) return res.status(401).json({ error: 'Invalid credentials' });",
      "",
      "    const bcrypt = require('bcrypt');",
      "    const match = await bcrypt.compare(password, row.password_hash);",
      "    if (!match) return res.status(401).json({ error: 'Invalid credentials' });",
      "",
      "    const jwt = require('jsonwebtoken');",
      "    const token = jwt.sign(",
      "      { userId: row.id, role: row.role },",
      "      process.env.JWT_SECRET || '${3:secret}',",
      "      { expiresIn: '${4:1h}' }",
      "    );",
      "",
      "    res.json({ token, user: { id: row.id, email: row.email, role: row.role } });",
      "  } catch (err) {",
      "    res.status(500).json({ error: err.message });",
      "  }",
      "});"
    ]
  },

  "Forgot Password Route": {
    "prefix": ["njs-forgot", "njs-fp"],
    "description": "[Auth] POST /auth/forgot-password - generate reset token and save to DB",
    "body": [
      "// Requires: nodemailer, dotenv | Insert near routes section",
      "app.post('/${1:auth/forgot-password}', async (req, res) => {",
      "  const { email } = req.body;",
      "  try {",
      "    const row = db.prepare('SELECT * FROM ${2:users} WHERE email = ?').get(email);",
      "    if (row) {",
      "      const crypto = require('crypto');",
      "      const token = crypto.randomBytes(32).toString('hex');",
      "      const expires = Date.now() + 3600000;",
      "",
      "      db.prepare(",
      "        'UPDATE ${2:users} SET reset_token = ?, reset_expires = ? WHERE id = ?'",
      "      ).run(token, expires, row.id);",
      "",
      "      // Use njs-mail to send the reset link via email",
      "      console.log('Reset token for', email, ':', token);",
      "    }",
      "    res.json({ message: 'If that email exists, a reset link was sent.' });",
      "  } catch (err) {",
      "    res.status(500).json({ error: err.message });",
      "  }",
      "});"
    ]
  },

