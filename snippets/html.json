{
  "API Item List UI": {
    "prefix": "njs-list",
    "description": "HTML listing + fetch UI for items with name, description, price",
    "body": [
      "<h1>${1:Items}</h1>",
      "<div id=\"${2:list}\">Loading...</div>",
      "",
      "<script>",
      "  const API = '${3:http://localhost:3000/api/items}';",
      "",
      "  async function loadItems() {",
      "    const res = await fetch(API);",
      "    const items = await res.json();",
      "    const list = document.getElementById('${2:list}');",
      "    if (!items.length) { list.innerHTML = '<p>No items yet.</p>'; return; }",
      "    list.innerHTML = items.map(i => `",
      "      <div class=\"${4:item}\">",
      "        <div>",
      "          <b>\\${i.${5:name}}</b> <span class=\"${6:price}\">\\$\\${i.${7:price}}</span>",
      "          <p style=\"margin:4px 0 0;color:#555;\">\\${i.${8:description} || ''}</p>",
      "        </div>",
      "        <button class=\"${9:delete}\" onclick=\"remove(\\${i.id})\">Delete</button>",
      "      </div>",
      "    `).join('');",
      "  }",
      "",
      "  async function remove(id) {",
      "    if (!confirm('Delete this item?')) return;",
      "    await fetch(`\\${API}/\\${id}`, { method: 'DELETE' });",
      "    loadItems();",
      "  }",
      "",
      "  loadItems();",
      "</script>"
    ]
  },

  "API Add Form": {
    "prefix": "njs-form",
    "description": "HTML form to add items via POST to API",
    "body": [
      "<h1>Add ${1:Item}</h1>",
      "<form id=\"${2:addForm}\" onsubmit=\"event.preventDefault(); addItem();\">",
      "  <input id=\"${3:name}\" placeholder=\"${4:Name}\" required>",
      "  <textarea id=\"${5:desc}\" placeholder=\"${6:Description}\" rows=\"2\"></textarea>",
      "  <input id=\"${7:price}\" type=\"number\" step=\"0.01\" placeholder=\"${8:Price}\" required>",
      "  <button type=\"submit\">Add</button>",
      "</form>",
      "",
      "<script>",
      "  const API = '${9:http://localhost:3000/api/items}';",
      "",
      "  async function addItem() {",
      "    const ${3:name} = document.getElementById('${3:name}').value;",
      "    const ${5:desc} = document.getElementById('${5:desc}').value;",
      "    const ${7:price} = parseFloat(document.getElementById('${7:price}').value);",
      "    if (!${3:name} || isNaN(${7:price})) return alert('${4:Name} and ${8:Price} required');",
      "",
      "    await fetch(API, {",
      "      method: 'POST',",
      "      headers: { 'Content-Type': 'application/json' },",
      "      body: JSON.stringify({ ${3:name}, ${5:desc}, ${7:price} })",
      "    });",
      "",
      "    document.getElementById('${2:addForm}').reset();",
      "    if (typeof loadItems === 'function') loadItems();",
      "  }",
      "</script>"
    ]
  },

  "Full Item Manager Page": {
    "prefix": "njs-page",
    "description": "Complete HTML page with add form and item list",
    "body": [
      "<!DOCTYPE html>",
      "<html>",
      "<head>",
      "  <meta charset=\"UTF-8\">",
      "  <title>${1:Item Manager}</title>",
      "  <style>",
      "    body { font-family: sans-serif; max-width: 600px; margin: 40px auto; padding: 0 20px; }",
      "    form { display: flex; flex-direction: column; gap: 10px; margin-bottom: 30px; }",
      "    input, textarea, button { padding: 10px; font-size: 1rem; }",
      "    .item { border: 1px solid #ddd; padding: 12px; margin-bottom: 10px; border-radius: 6px; display: flex; justify-content: space-between; align-items: center; }",
      "    .price { color: green; font-weight: bold; }",
      "    .delete { background: crimson; color: white; border: none; border-radius: 4px; cursor: pointer; }",
      "  </style>",
      "</head>",
      "<body>",
      "  <h1>Add ${2:Item}</h1>",
      "  <form id=\"addForm\" onsubmit=\"event.preventDefault(); addItem();\">",
      "    <input id=\"name\" placeholder=\"${3:Name}\" required>",
      "    <textarea id=\"desc\" placeholder=\"${4:Description}\" rows=\"2\"></textarea>",
      "    <input id=\"price\" type=\"number\" step=\"0.01\" placeholder=\"${5:Price}\" required>",
      "    <button type=\"submit\">Add</button>",
      "  </form>",
      "",
      "  <h1>${1:Items}</h1>",
      "  <div id=\"list\">Loading...</div>",
      "",
      "  <script>",
      "    const API = '${6:http://localhost:3000/api/items}';",
      "",
      "    async function loadItems() {",
      "      const res = await fetch(API);",
      "      const items = await res.json();",
      "      const list = document.getElementById('list');",
      "      if (!items.length) { list.innerHTML = '<p>No items yet.</p>'; return; }",
      "      list.innerHTML = items.map(i => `",
      "        <div class=\"item\">",
      "          <div>",
      "            <b>\\${i.${7:name}}</b> <span class=\"price\">\\$\\${i.${8:price}}</span>",
      "            <p style=\"margin:4px 0 0;color:#555;\">\\${i.${9:description} || ''}</p>",
      "          </div>",
      "          <button class=\"delete\" onclick=\"remove(\\${i.id})\">Delete</button>",
      "        </div>",
      "      `).join('');",
      "    }",
      "",
      "    async function addItem() {",
      "      const name = document.getElementById('name').value;",
      "      const description = document.getElementById('desc').value;",
      "      const price = parseFloat(document.getElementById('price').value);",
      "      if (!name || isNaN(price)) return alert('${3:Name} and ${5:Price} required');",
      "",
      "      await fetch(API, {",
      "        method: 'POST',",
      "        headers: { 'Content-Type': 'application/json' },",
      "        body: JSON.stringify({ name, description, price })",
      "      });",
      "",
      "      document.getElementById('addForm').reset();",
      "      loadItems();",
      "    }",
      "",
      "    async function remove(id) {",
      "      if (!confirm('Delete this item?')) return;",
      "      await fetch(`\\${API}/\\${id}`, { method: 'DELETE' });",
      "      loadItems();",
      "    }",
      "",
      "    loadItems();",
      "  </script>",
      "</body>",
      "</html>"
    ]
  },

