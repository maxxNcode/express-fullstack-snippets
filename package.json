{
  "name": "nodejs-express-workbench",
  "displayName": "NODEJS EXPRESS WORKBENCH",
  "description": "The ultimate VS Code extension for Express + SQLite full-stack development. Includes 45+ schema-aware njs-snippets for CRUD, Auth, Security, Frontend.",
  "version": "3.9.2",
  "publisher": "weonlyliveonce",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/weonlyliveonce/nodejs-express-workbench.git"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Snippets",
    "Other"
  ],
  "main": "./src/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "node-sqlite-ai.enable",
        "title": "AI: Turn On"
      },
      {
        "command": "node-sqlite-ai.trained-enable",
        "title": "AI: Trained On"
      },
      {
        "command": "node-sqlite-ai.disable",
        "title": "AI: Turn Off"
      },
      {
        "command": "node-sqlite-ai.magicComplete",
        "title": "AI: Generate from njs: instruction"
      },
      {
        "command": "node-sqlite-ai.fixSelection",
        "title": "AI: Fix Selected Code"
      },
      {
        "command": "node-sqlite-ai.registerTable",
        "title": "njs: Register Table"
      },
      {
        "command": "node-sqlite-ai.removeTable",
        "title": "njs: Remove Table"
      },
      {
        "command": "node-sqlite-ai.modifyTable",
        "title": "njs: Modify Table Fields"
      },
      {
        "command": "node-sqlite-ai.registerFromSql",
        "title": "njs: Register this table"
      },
      {
        "command": "node-sqlite-ai.showStatus",
        "title": "njs: Schema Status"
      },
      {
        "command": "node-sqlite-ai.manageFK",
        "title": "njs: Add Foreign Key"
      },
      {
        "command": "node-sqlite-ai.removeFK",
        "title": "njs: Remove Foreign Key"
      },
      {
        "command": "node-sqlite-ai.openSchemaView",
        "title": "njs: Schema Visualizer"
      },
      {
        "command": "node-sqlite-ai.generateAll",
        "title": "njs: Generate All Tables"
      },
      {
        "command": "node-sqlite-ai.generateProject",
        "title": "njs: Generate Project Files"
      },
      {
        "command": "node-sqlite-ai.tailwindSetup",
        "title": "njs: Setup TailwindCSS"
      },
      {
        "command": "node-sqlite-ai.parseMysqlSchema",
        "title": "njs: Parse MySQL Schema"
      },
      {
        "command": "node-sqlite-ai.parseMysqlInsert",
        "title": "njs: Parse MySQL Insert"
      }
    ],
    "keybindings": [
      {
        "key": "tab",
        "command": "node-sqlite-ai.magicComplete",
        "when": "editorTextFocus && njsAiEnabled && njsMagicLine && !suggestWidgetVisible && !inlineSuggestionVisible"
      },
      {
        "key": "ctrl+shift+f",
        "command": "node-sqlite-ai.fixSelection",
        "when": "editorTextFocus && njsAiEnabled"
      },
      {
        "key": "ctrl+shift+t",
        "command": "node-sqlite-ai.trained-enable",
        "when": "!njsAiEnabled"
      }
    ],
    "configuration": {
      "title": "NODEJS EXPRESS WORKBENCH",
      "properties": {
        "node-sqlite-ai.port": {
          "type": "number",
          "default": 23333,
          "description": "Port for the local AI server"
        },
        "node-sqlite-ai.magicPrefix": {
          "type": "string",
          "default": "njs:",
          "description": "Text prefix to trigger AI code generation"
        },
        "node-sqlite-ai.enableAutocomplete": {
          "type": "boolean",
          "default": false,
          "description": "Enable inline ghost text autocomplete"
        }
      }
    },
    "snippets": [
      {
        "language": "javascript",
        "path": "./snippets/javascript.json"
      },
      {
        "language": "json",
        "path": "./snippets/javascript.json"
      },
      {
        "language": "jsonc",
        "path": "./snippets/javascript.json"
      },
      {
        "language": "typescript",
        "path": "./snippets/javascript.json"
      },
      {
        "language": "javascriptreact",
        "path": "./snippets/javascript.json"
      },
      {
        "language": "typescriptreact",
        "path": "./snippets/javascript.json"
      },
      {
        "language": "html",
        "path": "./snippets/html.json"
      }
    ]
  },
  "dependencies": {
    "sql.js": "^1.14.1"
  },
  "scripts": {
    "test": "node -r ./test/shim.js test/generator.test.js && node test/queryGenerator.test.js && node -r ./test/shim.js test/screenGenerator.test.js"
  }
}
